# Source 2D para Windows, compilado desde Linux con zig (trae su propio mingw: no hace falta instalar nada mas).
#   make -f Makefile.win player   -> build/win/source2d-player.exe (jugador: base de los juegos exportados)
#   make -f Makefile.win editor   -> build/win/Source2D.exe (editor; antes hace falta "make" para build/gen)
#   ZIG=/ruta/a/zig make -f Makefile.win ...   para usar otro zig (tools/release.sh lo hace todo)
# Los .exe solo usan DLL del sistema de Windows (kernel32, user32, gdi32, opengl32, winmm, shell32...).
# Con zig la biblioteca de C es la UCRT (api-ms-win-crt-*.dll): viene en Windows 10 y 11; en 7 y 8.1 solo con la
# actualizacion KB2999226 y en Vista no existe. Para que abran tambien ahi, descarga llvm-mingw en su variante msvcrt
# (https://github.com/mstorsjo/llvm-mingw/releases, "...-msvcrt-ubuntu-...-x86_64.tar.xz") y descomprimela en
# build/toolchain/llvm-mingw/: si esta, se usa ella (msvcrt.dll, que trae cualquier Windows desde XP).
ZIG        ?= zig
TARGET      = x86_64-windows-gnu
MINGW      ?= $(wildcard build/toolchain/llvm-mingw/bin/x86_64-w64-mingw32-clang)
ifneq ($(MINGW),)
CC          = $(MINGW)
CXX         = $(MINGW)++
else
CC          = $(ZIG) cc -target $(TARGET)
CXX         = $(ZIG) c++ -target $(TARGET)
endif
QJS_DIR    ?= third_party/quickjs
RAYLIB_DIR  = third_party/raylib/src
IMGUI_DIR   = third_party/imgui
RLIMGUI_DIR = third_party/rlImGui
JSON_DIR    = third_party/json
OUT         = build/win
CFLAGS      = -O2 -std=c11 -fno-strict-aliasing -w
CXXFLAGS    = -Os -std=c++17 -w -ffunction-sections -fdata-sections
WINLIBS     = -lopengl32 -lgdi32 -lwinmm -luser32 -lshell32 -lkernel32 -lole32 -lcomdlg32
# subsistema "windows": sin consola negra al abrir el .exe
LDWIN       = -static -Wl,--subsystem,windows
# manifiesto (src/win/source2d.manifest): el programa usa UTF-8 en las rutas (usuarios con tildes, carpetas "Ámbar"...)
RES         = $(OUT)/source2d.res
$(RES): src/win/source2d.rc src/win/source2d.manifest | $(OUT)
ifneq ($(MINGW),)
	$(MINGW:clang=windres) -O coff src/win/source2d.rc -o $@
else
	$(ZIG) rc /fo $@ src/win/source2d.rc
endif

all: $(OUT)/source2d-player.exe $(OUT)/Source2D.exe

$(OUT) $(OUT)/raylib $(OUT)/qjs $(OUT)/imgui $(OUT)/editor $(OUT)/gen:
	mkdir -p $@

RAYLIB_SRC = rcore rshapes rtextures rtext rmodels utils raudio rglfw
RAYLIB_OBJ = $(patsubst %,$(OUT)/raylib/%.o,$(RAYLIB_SRC))
$(OUT)/raylib/%.o: $(RAYLIB_DIR)/%.c | $(OUT)/raylib
	$(CC) $(CFLAGS) -std=gnu99 -DPLATFORM_DESKTOP -DGRAPHICS_API_OPENGL_21 -I$(RAYLIB_DIR) -I$(RAYLIB_DIR)/external/glfw/include -c $< -o $@

QJS_SRC = dtoa libregexp libunicode quickjs
QJS_OBJ = $(patsubst %,$(OUT)/qjs/%.o,$(QJS_SRC))
$(OUT)/qjs/%.o: $(QJS_DIR)/%.c | $(OUT)/qjs
	$(CC) -O3 -w -D_GNU_SOURCE -DWIN32_LEAN_AND_MEAN -D_WIN32_WINNT=0x0601 -I$(QJS_DIR) -c $< -o $@

libs: $(RAYLIB_OBJ) $(QJS_OBJ)

# ---- jugador ----
player: $(OUT)/source2d-player.exe
$(OUT)/source2d-player.exe: $(RES) src/main.c src/platform_raylib.c src/text.c src/gpu_vulkan.c src/vk_shaders.h src/steam.c src/steam.h src/runtime_js.h src/gfx_js.h src/licencias_jugador.h src/font_data.h $(RAYLIB_OBJ) $(QJS_OBJ) | $(OUT)
	$(CC) $(CFLAGS) -Isrc -I$(QJS_DIR) -I$(RAYLIB_DIR) -I$(RAYLIB_DIR)/external -DPLAYER -c src/main.c -o $(OUT)/main_player.o
	$(CC) $(CFLAGS) -Isrc -I$(RAYLIB_DIR) -c src/platform_raylib.c -o $(OUT)/platform_raylib.o
	$(CC) $(CFLAGS) -Isrc -I$(RAYLIB_DIR)/external -c src/text.c -o $(OUT)/text.o
	$(CC) $(CFLAGS) -Isrc -Ithird_party/vulkan/include -c src/gpu_vulkan.c -o $(OUT)/gpu_vulkan.o
	$(CC) $(CFLAGS) -Isrc -c src/steam.c -o $(OUT)/steam.o
	$(CC) $(OUT)/main_player.o $(OUT)/platform_raylib.o $(OUT)/text.o $(OUT)/gpu_vulkan.o $(OUT)/steam.o $(RAYLIB_OBJ) $(QJS_OBJ) $(RES) -o $@ $(LDWIN) $(WINLIBS)

# ---- motor ligero y lanzador de la exportacion ligera (ver Makefile.linux) ----
LITE       = $(OUT)/lite
LITE_FLAGS = -Os -flto -w -ffunction-sections -fdata-sections
LITE_RL    = $(patsubst %,$(LITE)/raylib/%.o,rcore rtextures utils raudio rglfw)
# GLFW lleva un parche de Source 2D (aviso de archivos arrastrandose encima): rglfw.o depende de esos archivos
GLFW_PATCHED = $(RAYLIB_DIR)/external/glfw/src/input.c $(RAYLIB_DIR)/external/glfw/src/x11_window.c
$(OUT)/raylib/rglfw.o $(LITE)/raylib/rglfw.o: $(GLFW_PATCHED)
LITE_QJS   = $(patsubst %,$(LITE)/qjs/%.o,$(QJS_SRC))
$(LITE)/raylib/%.o: $(RAYLIB_DIR)/%.c src/raylib_lite_config.h
	@mkdir -p $(LITE)/raylib
	$(CC) $(LITE_FLAGS) -std=gnu99 -DPLATFORM_DESKTOP -DGRAPHICS_API_OPENGL_21 -DEXTERNAL_CONFIG_FLAGS -include src/raylib_lite_config.h -I$(RAYLIB_DIR) -I$(RAYLIB_DIR)/external/glfw/include -c $< -o $@
$(LITE)/qjs/%.o: $(QJS_DIR)/%.c
	@mkdir -p $(LITE)/qjs
	$(CC) $(LITE_FLAGS) -D__STDC_NO_ATOMICS__=1 -D_GNU_SOURCE -DWIN32_LEAN_AND_MEAN -D_WIN32_WINNT=0x0601 -I$(QJS_DIR) -c $< -o $@
$(LITE)/source2d-lite.exe: $(RES) src/main.c src/platform_raylib.c src/text.c src/gpu_vulkan.c src/vk_shaders.h src/steam.c src/steam.h src/runtime_js.h src/gfx_js.h src/licencias_jugador.h src/font_data_mini.h $(LITE_RL) $(LITE_QJS)
	$(CC) $(LITE_FLAGS) -std=c11 -fno-strict-aliasing -Isrc -I$(QJS_DIR) -I$(RAYLIB_DIR) -I$(RAYLIB_DIR)/external -DPLAYER -DS2D_LITE -c src/main.c -o $(LITE)/main.o
	$(CC) $(LITE_FLAGS) -std=c11 -fno-strict-aliasing -DS2D_LITE -Isrc -I$(RAYLIB_DIR) -c src/platform_raylib.c -o $(LITE)/platform.o
	$(CC) $(LITE_FLAGS) -std=c11 -fno-strict-aliasing -DS2D_LITE -Isrc -I$(RAYLIB_DIR)/external -c src/text.c -o $(LITE)/text.o
	$(CC) $(LITE_FLAGS) -std=gnu99 -Isrc -Ithird_party/vulkan/include -c src/gpu_vulkan.c -o $(LITE)/gpu_vulkan.o
	$(CC) $(LITE_FLAGS) -std=gnu99 -Isrc -c src/steam.c -o $(LITE)/steam.o
	$(CC) $(LITE)/main.o $(LITE)/platform.o $(LITE)/text.o $(LITE)/gpu_vulkan.o $(LITE)/steam.o $(LITE_RL) $(LITE_QJS) $(RES) -o $@ -s -Wl,--gc-sections $(LDWIN) $(WINLIBS)
# el lanzador de Windows va sin CRT (solo kernel32 y user32): unos pocos KB en vez de ~80. Con -nostdlib zig no pone
# las cabeceras de mingw: se toman de su carpeta lib
ZIG_LIB = $(shell $(ZIG) env | sed -n 's/.*\.lib_dir = "\(.*\)",/\1/p')
$(LITE)/stub.exe: src/stub.c src/lzdec.h
	@mkdir -p $(LITE)
	$(CC) -Os -w -nostdlib -isystem $(ZIG_LIB)/libc/include/any-windows-any -ffreestanding -mno-stack-arg-probe -ffunction-sections -fdata-sections -I$(RAYLIB_DIR)/external src/stub.c -o $@ \
		-s -Wl,--gc-sections -Wl,--entry=start -Wl,--subsystem,windows -lkernel32 -luser32
lite: $(LITE)/source2d-lite.exe $(LITE)/stub.exe

# ---- editor (usa las cabeceras de build/gen que genera el Makefile normal) ----
IMGUI_SRC = $(IMGUI_DIR)/imgui.cpp $(IMGUI_DIR)/imgui_draw.cpp $(IMGUI_DIR)/imgui_tables.cpp $(IMGUI_DIR)/imgui_widgets.cpp $(RLIMGUI_DIR)/rlImGui.cpp
IMGUI_OBJ = $(patsubst %.cpp,$(OUT)/imgui/%.o,$(notdir $(IMGUI_SRC)))
EDITOR_SRC = $(wildcard src/editor/*.cpp)
EDITOR_OBJ = $(patsubst src/editor/%.cpp,$(OUT)/editor/%.o,$(EDITOR_SRC))
EDITOR_INC = -Isrc -Isrc/editor -Ibuild/gen -I$(RAYLIB_DIR) -I$(IMGUI_DIR) -I$(RLIMGUI_DIR) -I$(JSON_DIR) -I$(QJS_DIR)

$(OUT)/imgui/%.o: $(IMGUI_DIR)/%.cpp | $(OUT)/imgui
	$(CXX) $(CXXFLAGS) -I$(IMGUI_DIR) -I$(RAYLIB_DIR) -c $< -o $@
$(OUT)/imgui/rlImGui.o: $(RLIMGUI_DIR)/rlImGui.cpp | $(OUT)/imgui
	$(CXX) $(CXXFLAGS) -I$(IMGUI_DIR) -I$(RAYLIB_DIR) -c $< -o $@
$(OUT)/editor/%.o: src/editor/%.cpp $(wildcard src/editor/*.hpp) src/runtime_js.h build/gen/gfx_web_js.h build/gen/players_portable.c | $(OUT)/editor
	$(CXX) $(CXXFLAGS) $(EDITOR_INC) -c $< -o $@

# los motores que lleva el editor para exportar (tools/gen_players.py): siempre los de Makefile.linux y Makefile.win
# (Linux con glibc 2.28), nunca el del gcc del sistema. Hay que compilarlos antes: tools/release.sh lo hace.
PORTABLE_PLAYERS = build/lnx/lite/stub build/lnx/source2d-player build/lnx/lite/source2d-lite build/win/lite/stub.exe build/win/source2d-player.exe build/win/lite/source2d-lite.exe
build/gen/players_portable.c: $(wildcard $(PORTABLE_PLAYERS)) tools/gen_players.py
	@mkdir -p build/gen
	python3 tools/gen_players.py $@ $(PORTABLE_PLAYERS)
$(OUT)/gen/players_portable.o: build/gen/players_portable.c | $(OUT)/gen
	$(CC) -c $< -o $@

editor: $(OUT)/Source2D.exe
$(OUT)/Source2D.exe: $(EDITOR_OBJ) $(IMGUI_OBJ) $(OUT)/gen/players_portable.o $(RAYLIB_OBJ) $(QJS_OBJ) $(RES)
	$(CXX) $^ -o $@ $(LDWIN) $(WINLIBS) -lws2_32 -liphlpapi

clean:
	rm -rf $(OUT)

.PHONY: all libs player lite editor clean
