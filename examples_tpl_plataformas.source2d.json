"enabled":true,"invert":false,"params":{"object":"o_vjptui","with":"o_2jwp8b"}}],"actions":[{"type":"removeObj","enabled":true,"invert":false,"params":{"object":"o_2jwp8b"}},{"type":"addGlobal","enabled":true,"invert":false,"params":{"variable":"puntos","value":"10"}},{"type":"tweenScale","enabled":true,"invert":false,"params":{"object":"o_zyljis","x":"1.3","y":"1.3","duration":"0.1","easing":"easeOut"}},{"type":"beep","enabled":true,"invert":false,"params":{"freq":"940","duration":"0.07"}}]},{"id":"nt_t0006","kind":"comment","text":"Cuando la animacion del marcador termina, vuelve a su tamano."},{"id":"ev_t0007","enabled":true,"level":0,"conditions":[{"type":"tweenDone","enabled":true,"invert":false,"params":{"object":"o_zyljis"}}],"actions":[{"type":"tweenScale","enabled":true,"invert":false,"params":{"object":"o_zyljis","x":"1","y":"1","duration":"0.15","easing":"easeOut"}}]},{"id":"nt_t0008","kind":"comment","text":"Tocar un enemigo: la camara tiembla, se congela un instante (pausa de impacto) y se pierde."},{"id":"ev_t0009","enabled":true,"level":0,"conditions":[{"type":"collision","enabled":true,"invert":false,"params":{"object":"o_vjptui","with":"o_7s76iq"}}],"actions":[{"type":"shakeCamera","enabled":true,"invert":false,"params":{"intensity":"14","duration":"0.4"}},{"type":"hitStop","enabled":true,"invert":false,"params":{"seconds":"0.08"}},{"type":"endGame","enabled":true,"invert":false,"params":{"message":"Has perdido. Puntos: {g:puntos}. Pulsa R"}}]},{"id":"nt_t0010","kind":"comment","text":"Caerse fuera del nivel tambien es perder."},{"id":"ev_t0011","enabled":true,"level":0,"conditions":[{"type":"objOutside","enabled":true,"invert":false,"params":{"object":"o_vjptui"}}],"actions":[{"type":"endGame","enabled":true,"invert":false,"params":{"message":"Te has caido. Pulsa R"}}]},{"id":"nt_t0012","kind":"comment","text":"Ganar: con 120 puntos (todas las monedas) el marcador lo dice. Cambia la cifra si pones mas monedas."},{"id":"ev_t0013","enabled":true,"lev